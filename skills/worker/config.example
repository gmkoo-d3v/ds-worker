# ds-worker configuration
#
# Copy to ~/.config/ds-worker/config (install.sh does this for you if it is
# missing) and uncomment what you want to change. An environment variable of
# the same name always wins, so you can still override per call:
#
#   DS_MODEL_REVIEWER=<provider/model> ds-worker reviewer "..."
#
# This file is PARSED, not sourced. Only the keys listed below are read, values
# are taken literally, and nothing here is executed. No $(...), no variables.
# Check what is actually in effect with:  ds-doctor --config

# --- models -----------------------------------------------------------------
# There is no built-in model. Pick any model OpenCode can reach — a local
# server (vLLM, llama.cpp, Ollama, LM Studio, ...) registered as a provider in
# opencode.jsonc, or a hosted API you signed in to with `opencode auth login` —
# and name it the way `opencode models` prints it:
#
#   opencode models
#   install.sh --model <provider/model>     # writes DS_MODEL below
#
# DS_MODEL serves every role; the per-role keys override it for one role.
#DS_MODEL=local/your-model
#DS_MODEL_EXPLORER=
#DS_MODEL_REVIEWER=
#DS_MODEL_WORKER=

# Each role tries its model up to DS_MODEL_RETRIES times, then its FALLBACK
# model up to DS_MODEL_RETRIES more times, stopping at the first success.
# Fallbacks are empty by default, so a spent primary fails the call outright.
# --model on a single call bypasses the chain and runs exactly that model once.
# For the writing `worker` role, the chain only continues while --dir is a git
# working tree confirmed unchanged since the chain started (see
# references/verification.md, "Safety model").
#DS_MODEL_EXPLORER_FALLBACK=
#DS_MODEL_REVIEWER_FALLBACK=
#DS_MODEL_WORKER_FALLBACK=
#DS_MODEL_RETRIES=2

# The critic role runs the doc-critic agent. Pick a model OTHER than DS_MODEL,
# so the audit is cross-model. Empty = OpenCode's default model.
# install.sh --critic-model <provider/model> writes it.
#DS_MODEL_CRITIC=

# ds-worker-rr rotates --model over these (space-separated), one step per call
# and per role — for example to spread load over several hosted APIs. Fewer
# than two = no rotation.
#DS_RR_MODELS=

# --- endpoint and autodetect -------------------------------------------------
# DS_MODEL_ENDPOINT is the OpenAI-compatible base URL (ending in /v1) that
# `ds-worker direct` and autodetect talk to. Empty = read the baseURL out of
# opencode.jsonc for the model's provider, so the URL has one home.
#
# A local server often serves ONE model at a time, so a pinned name goes stale
# when you load another. With autodetect on, ds-worker asks the endpoint which
# models it serves and switches only when that is one model (a single entry,
# or aliases sharing one `root`, as vLLM lists them), and only to a model in
# the provider's catalog in opencode.jsonc. A configured alias is kept; a
# hosted API listing several models keeps its pin. --model always wins.
#
# DS_MODEL_API_KEY_ENV names the environment variable that holds the
# endpoint's API key (for example OPENAI_API_KEY). Only `direct` and autodetect
# use it; OpenCode roles use OpenCode's own credentials. Never put the key
# itself in this file.
#DS_MODEL_ENDPOINT=
#DS_MODEL_AUTODETECT=1
#DS_MODEL_API_KEY_ENV=

# A key may appear more than once; the last line wins. Copy a block, edit the
# copy, and the earlier one stays as a record of what you moved away from.

# --- execution --------------------------------------------------------------
# DS_IDLE_TIMEOUT  seconds with no OpenCode NDJSON output before exit 124;
#                  reasoning, answer, and tool events all reset this timer;
#                  0 disables this outer idle watchdog
# DS_MAX_RUNTIME   absolute wall-clock limit for one call (exit 124)
# DS_TIMEOUT       legacy alias for DS_MAX_RUNTIME
# DS_SERVE    off = private --standalone server per call (default),
#             auto = run --server against the ds-serve backend (password in
#             $DS_STATE_DIR/serve.password); read-only recovery stays --standalone
# DS_AUTO     1 = pass --auto. Required for headless runs; it cannot override a
#             `deny` in an agent definition, which is what keeps the read-only
#             roles read-only. Set to 0 only when debugging permission prompts.
# DS_PROGRESS_INTERVAL  seconds between numeric stderr progress reports; 0 disables
# DS_AUTO_RECOVER_READONLY  1 = one session recovery for explorer/reviewer
# DS_RECOVERY_IDLE_TIMEOUT / DS_RECOVERY_MAX_RUNTIME  recovery watchdog limits

#DS_IDLE_TIMEOUT=1200
#DS_MAX_RUNTIME=3600
#DS_TIMEOUT=3600
#DS_PROGRESS_INTERVAL=15
#DS_AUTO_RECOVER_READONLY=1
#DS_RECOVERY_IDLE_TIMEOUT=60
#DS_RECOVERY_MAX_RUNTIME=180
#DS_SERVE=off
#DS_AUTO=1

# --- backend ----------------------------------------------------------------
# DS_OPENCODE_PORT is a starting point. If it is busy (an OpenCode TUI often
# holds 4096), ds-serve scans upward and never attaches to a server it did not
# start (checked by the pid an authenticated GET /api/info reports). Binding
# anything other than loopback requires a caller-set OPENCODE_SERVER_PASSWORD.

#DS_OPENCODE_HOST=127.0.0.1
#DS_OPENCODE_PORT=4096
#DS_PORT_SCAN=20

# --- local reasoning model --------------------------------------------------
# These are OpenCode provider options, not ds-worker config keys. In
# ~/.config/opencode/opencode.jsonc, set them under the local provider used by
# the selected model. `chunkTimeout` is the gap between streamed SSE chunks;
# `timeout` is the provider request's absolute limit.
#
#   "options": {
#     "chunkTimeout": 60000,
#     "timeout": 1800000
#   }
#
# Restart the owned backend after changing provider options:
#   ds-serve restart

# --- paths ------------------------------------------------------------------
#DS_STATE_DIR=~/.local/state/ds-worker
