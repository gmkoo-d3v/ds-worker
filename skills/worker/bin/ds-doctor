#!/usr/bin/env bash
# ds-doctor — check that delegation to the configured model is actually wired up.
set -uo pipefail

# install.sh links this file into ~/.local/bin; resolve that to find lib/.
SOURCE_PATH="${BASH_SOURCE[0]}"
SOURCE_HOPS=0
while [ -L "$SOURCE_PATH" ]; do
  SOURCE_HOPS=$((SOURCE_HOPS + 1))
  [ "$SOURCE_HOPS" -le 40 ] || { printf 'ds-doctor: symlink chain too deep\n' >&2; exit 2; }
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
  SOURCE_PATH="$(readlink "$SOURCE_PATH")"
  case "$SOURCE_PATH" in /*) ;; *) SOURCE_PATH="$SOURCE_DIR/$SOURCE_PATH" ;; esac
done
SELF_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
. "$SELF_DIR/../lib/opencode-cli.sh"
. "$SELF_DIR/../lib/model-endpoint.sh"

DS_CONFIG="${DS_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/ds-worker/config}"

# One list, so --config can report a default without invoking the other tools.
# Keep in sync with the defaults in ds-worker and ds-serve.
ds_default() {
  case "$1" in
    DS_MODEL)          echo "" ;;   # no built-in model: install.sh --model sets it
    DS_MODEL_EXPLORER|DS_MODEL_REVIEWER|DS_MODEL_WORKER) echo "${DS_MODEL_EFF:-}" ;;   # = DS_MODEL
    DS_MODEL_API_KEY_ENV|DS_RR_MODELS) echo "" ;;
    DS_MODEL_EXPLORER_FALLBACK|DS_MODEL_REVIEWER_FALLBACK|DS_MODEL_WORKER_FALLBACK) echo "" ;;
    DS_MODEL_CRITIC) echo "" ;;   # empty = OpenCode's default model
    DS_MODEL_RETRIES)  echo 2 ;;
    DS_MODEL_AUTODETECT) echo 1 ;;
    DS_MODEL_ENDPOINT) echo "" ;;
    DS_TIMEOUT)        echo 3600 ;;
    DS_IDLE_TIMEOUT)   echo 1200 ;;
    DS_MAX_RUNTIME)    echo 3600 ;;
    DS_SERVE)          echo off ;;
    DS_AUTO)           echo 1 ;;
    DS_OPENCODE_HOST)  echo 127.0.0.1 ;;
    DS_OPENCODE_PORT)  echo 4096 ;;
    DS_PORT_SCAN)      echo 20 ;;
    DS_STATE_DIR)      echo "${XDG_STATE_HOME:-$HOME/.local/state}/ds-worker" ;;
    DS_PROGRESS_INTERVAL)        echo 15 ;;
    DS_AUTO_RECOVER_READONLY)     echo 1 ;;
    DS_RECOVERY_IDLE_TIMEOUT)     echo 60 ;;
    DS_RECOVERY_MAX_RUNTIME)      echo 180 ;;
  esac
}

# Shared by ds-worker, ds-serve and ds-doctor: what the file says must be what
# runs, and what `ds-doctor --config` prints must be what the file says.
# Handles `key = value`, quoted values, a trailing ` # comment`, and a leading ~.
ds_norm_value() {
  local val="$1" key="${2:-}"
  val="${val%%$'\t'#*}"; case "$val" in *" #"*) val="${val%% #*}" ;; esac
  val="${val#"${val%%[![:space:]]*}"}"
  val="${val%"${val##*[![:space:]]}"}"
  case "$val" in
    \"*\") val="${val#\"}"; val="${val%\"}" ;;
    \'*\') val="${val#\'}"; val="${val%\'}" ;;
  esac
  case "$key" in *DIR) val="${val/#\~/$HOME}" ;; esac
  printf '%s' "$val"
}

ds_from_file() {
  [ -f "$DS_CONFIG" ] || return 0
  local raw
  raw="$(sed -n "s/^[[:space:]]*$1[[:space:]]*=//p" "$DS_CONFIG" 2>/dev/null | tail -1)"
  [ -n "$raw" ] || return 0
  ds_norm_value "$raw" "$1"
}

# Every role model defaults to DS_MODEL, so resolve that one first.
DS_MODEL_EFF="${DS_MODEL:-$(ds_from_file DS_MODEL)}"

# The point of a settings file is being able to see whether it actually took.
if [ "${1:-}" = "--config" ]; then
  if [ -f "$DS_CONFIG" ]; then printf 'config: %s\n\n' "$DS_CONFIG"
  else printf 'config: %s  (not present — built-in defaults)\n\n' "$DS_CONFIG"; fi
  timeout_from_file="$(ds_from_file DS_TIMEOUT)"
  max_runtime_from_file="$(ds_from_file DS_MAX_RUNTIME)"
  for k in DS_MODEL DS_MODEL_EXPLORER DS_MODEL_REVIEWER DS_MODEL_WORKER \
           DS_MODEL_EXPLORER_FALLBACK DS_MODEL_REVIEWER_FALLBACK DS_MODEL_WORKER_FALLBACK DS_MODEL_RETRIES \
           DS_MODEL_CRITIC \
           DS_MODEL_AUTODETECT DS_MODEL_ENDPOINT DS_MODEL_API_KEY_ENV DS_RR_MODELS \
           DS_TIMEOUT DS_IDLE_TIMEOUT DS_MAX_RUNTIME DS_SERVE DS_AUTO \
           DS_OPENCODE_HOST DS_OPENCODE_PORT DS_PORT_SCAN DS_STATE_DIR \
           DS_PROGRESS_INTERVAL DS_AUTO_RECOVER_READONLY \
           DS_RECOVERY_IDLE_TIMEOUT DS_RECOVERY_MAX_RUNTIME; do
    fv="$(ds_from_file "$k")"
    if [ "$k" = DS_MAX_RUNTIME ] && [ -z "${DS_MAX_RUNTIME:-}" ] \
       && [ -z "$max_runtime_from_file" ]; then
      if [ -n "${DS_TIMEOUT:-}" ]; then
        src="environment (DS_TIMEOUT)"; val="$DS_TIMEOUT"
      elif [ -n "$timeout_from_file" ]; then
        src="config file (DS_TIMEOUT)"; val="$timeout_from_file"
      else
        src=default; val="$(ds_default DS_MAX_RUNTIME)"
      fi
    elif [ -n "${!k:-}" ]; then src=environment; val="${!k}"
    elif [ -n "$fv" ];    then src="config file"; val="$fv"
    else                       src=default;      val="$(ds_default "$k")"
    fi
    printf '  %-19s %-32s %s\n' "$k" "$val" "$src"
  done
  exit 0
fi

DS_MODEL_EXPLORER="${DS_MODEL_EXPLORER:-$(ds_from_file DS_MODEL_EXPLORER)}"
DS_MODEL_REVIEWER="${DS_MODEL_REVIEWER:-$(ds_from_file DS_MODEL_REVIEWER)}"
DS_MODEL_WORKER="${DS_MODEL_WORKER:-$(ds_from_file DS_MODEL_WORKER)}"
DS_MODEL_EXPLORER="${DS_MODEL_EXPLORER:-$(ds_default DS_MODEL_EXPLORER)}"
DS_MODEL_REVIEWER="${DS_MODEL_REVIEWER:-$(ds_default DS_MODEL_REVIEWER)}"
DS_MODEL_WORKER="${DS_MODEL_WORKER:-$(ds_default DS_MODEL_WORKER)}"

DS_MODEL_EXPLORER_FALLBACK="${DS_MODEL_EXPLORER_FALLBACK:-$(ds_from_file DS_MODEL_EXPLORER_FALLBACK)}"
DS_MODEL_REVIEWER_FALLBACK="${DS_MODEL_REVIEWER_FALLBACK:-$(ds_from_file DS_MODEL_REVIEWER_FALLBACK)}"
DS_MODEL_WORKER_FALLBACK="${DS_MODEL_WORKER_FALLBACK:-$(ds_from_file DS_MODEL_WORKER_FALLBACK)}"
DS_MODEL_EXPLORER_FALLBACK="${DS_MODEL_EXPLORER_FALLBACK:-$(ds_default DS_MODEL_EXPLORER_FALLBACK)}"
DS_MODEL_REVIEWER_FALLBACK="${DS_MODEL_REVIEWER_FALLBACK:-$(ds_default DS_MODEL_REVIEWER_FALLBACK)}"
DS_MODEL_WORKER_FALLBACK="${DS_MODEL_WORKER_FALLBACK:-$(ds_default DS_MODEL_WORKER_FALLBACK)}"

FAIL=0
pass() { printf '  \033[32mok\033[0m    %s\n' "$1"; }
fail() { printf '  \033[31mFAIL\033[0m  %s\n' "$1"; FAIL=1; }
info() { printf '  --    %s\n' "$1"; }

echo "ds-doctor"

for c in opencode jq curl; do
  command -v "$c" >/dev/null && pass "$c ($(command -v "$c"))" || fail "$c not on PATH"
done

if command -v opencode >/dev/null; then
  info "opencode $(opencode --version 2>/dev/null | head -1)"

  creds="$(opencode auth list 2>/dev/null | grep -cE '^\S' || true)"
  [ "${creds:-0}" -gt 0 ] && pass "credentials present" || fail "no credentials — run: opencode auth login"

  models="$(opencode models 2>/dev/null)"
  [ -n "$DS_MODEL_EXPLORER$DS_MODEL_REVIEWER$DS_MODEL_WORKER" ] \
    || fail "no model configured — set DS_MODEL=<provider/model> (install.sh --model does it)"
  for m in "$DS_MODEL_EXPLORER" "$DS_MODEL_REVIEWER" "$DS_MODEL_WORKER" \
           "$DS_MODEL_EXPLORER_FALLBACK" "$DS_MODEL_REVIEWER_FALLBACK" "$DS_MODEL_WORKER_FALLBACK"; do
    [ -n "$m" ] || continue   # no fallback configured is the default, not a failure
    printf '%s\n' "$models" | grep -qxF "$m" \
      && pass "model $m" \
      || fail "model $m not available (see: opencode models)"
  done

  # Same precedence as ds-worker: environment, then the config file.
  DS_MODEL_API_KEY_ENV="${DS_MODEL_API_KEY_ENV:-$(ds_from_file DS_MODEL_API_KEY_ENV)}"
  endpoint="${DS_MODEL_ENDPOINT:-$(ds_from_file DS_MODEL_ENDPOINT)}"
  endpoint="${endpoint:-$(ds_provider_baseurl "${DS_MODEL_WORKER%%/*}")}"
  if [ -n "$endpoint" ]; then
    rc=0; served="$(ds_detect_served_model "$endpoint" "${DS_MODEL_WORKER#*/}")" || rc=$?
    case "$rc" in
      0) info "serving now: ${DS_MODEL_WORKER%%/*}/$served (at $endpoint)" ;;
      2) fail "DS_MODEL_API_KEY_ENV names '$DS_MODEL_API_KEY_ENV', but that variable is unset or not a valid name" ;;
      3) info "endpoint $endpoint serves several models — autodetect keeps the configured pin" ;;
      *) info "endpoint $endpoint: unreachable or needs an API key (DS_MODEL_API_KEY_ENV)" ;;
    esac
  fi

  agents="$(oc_agent_list)" || fail "'opencode debug agents' returned no JSON array — cannot list agents"
  agent_dir="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/agent"
  for a in ds-explorer ds-reviewer ds-worker doc-critic; do
    line="$(printf '%s\n' "$agents" | grep "^${a} " || true)"
    if [ -z "$line" ]; then
      fail "agent $a not installed — run sync-agents --install (or install.sh)"
    elif printf '%s' "$line" | grep -q '(subagent)'; then
      fail "agent $a is mode=subagent — 'run --agent' would fall back to the default agent"
    elif [ -L "$agent_dir/$a.md" ]; then
      fail "agent $a is a symlink — OpenCode lists it but ignores it at run time; re-run sync-agents --install (or install.sh)"
    elif [ ! -f "$agent_dir/$a.md" ]; then
      fail "agent $a file missing at $agent_dir/$a.md"
    else
      pass "agent $a"
    fi
  done

  # doc-critic binds no model of its own: DS_MODEL_CRITIC picks it, else
  # OpenCode's default model answers.
  critic_cfg="${DS_MODEL_CRITIC:-$(ds_from_file DS_MODEL_CRITIC 2>/dev/null || true)}"
  if [ -z "$critic_cfg" ]; then
    info "critic: no DS_MODEL_CRITIC — doc-critic runs on OpenCode's default model (set one other than DS_MODEL for a cross-model audit)"
  elif printf '%s\n' "$models" | grep -qxF "$critic_cfg"; then
    pass "critic model $critic_cfg"
    [ "$critic_cfg" != "$DS_MODEL_EFF" ] || info "critic model equals DS_MODEL — the audit is not cross-model"
  else
    fail "critic model $critic_cfg not available (see: opencode models)"
  fi

  cmd_file="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/command/doc-review.md"
  if [ -f "$cmd_file" ] && grep -q 'doc-critic' "$cmd_file"; then
    pass "doc-review command present and names doc-critic"
  elif [ -f "$cmd_file" ]; then
    fail "$cmd_file exists but does not invoke doc-critic"
  else
    fail "doc-review command missing — install.sh (or copy skill/worker/command/doc-review.md)"
  fi
fi

SERVE="$(dirname "$(command -v ds-serve || echo "$(dirname "$0")/ds-serve")")/ds-serve"
if url="$("$SERVE" url 2>/dev/null)"; then
  pass "backend up at $url (ours)"
else
  info "no backend of ours running (DS_SERVE=auto starts one; otherwise each call runs --standalone)"
fi

[ "$FAIL" -eq 0 ] && echo "all checks passed" || echo "some checks failed" >&2
exit "$FAIL"
