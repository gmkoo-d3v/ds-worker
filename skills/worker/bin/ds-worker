#!/usr/bin/env bash
# ds-worker — delegate one unit of work to a GX10 Qwen agent running under OpenCode.
# Built for the OpenCode v2 CLI (see lib/opencode-cli.sh).
#
#   ds-worker <role> [options] "<prompt>"
#   ds-worker <role> [options] -            # prompt on stdin
#
# roles:
#   explorer   read-only codebase mapping, repeated search, candidate gathering
#   reviewer   read-only analysis of test logs, stack traces, diffs
#   worker     tightly specified implementation (can edit files and run commands)
#   critic     cross-model audit of long documents — runs the doc-critic agent;
#              its model is bound in the agent config, not in this wrapper
#   omo        gateway to the OMO Slim agents (see "omo agents" below)
#   direct     one chat completion straight to the GX10 endpoint: no OpenCode,
#              no tools, files inlined (`ds-worker direct --help`)
#
# omo agents (ds-worker omo <agent> "<prompt>"):
#   oracle | council | librarian | designer | fixer | ds-explorer | ds-reviewer
#   The active OMO Slim preset picks the model for oracle, council, librarian,
#   designer and fixer — no --model is passed unless you give one explicitly.
#   Those five built-ins are OpenCode subagents, so each dispatches the primary
#   agent 'orchestrator' (or the fallback primary, below) via task(subagent_type='<agent>').
#   ds-explorer and ds-reviewer keep their configured local model and
#   final-report contract.
#
# The caller is the supervisor. Treat everything this prints as a claim to be
# verified, not as an established fact.
set -euo pipefail

# install.sh places an absolute symlink in ~/.local/bin. Resolve that symlink
# before locating the sibling lib/ directory in the repository.
SOURCE_PATH="${BASH_SOURCE[0]}"
SOURCE_HOPS=0
while [ -L "$SOURCE_PATH" ]; do
  SOURCE_HOPS=$((SOURCE_HOPS + 1))
  [ "$SOURCE_HOPS" -le 40 ] || {
    printf 'ds-worker: symlink chain too deep: %s\n' "$SOURCE_PATH" >&2
    exit 2
  }
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
  SOURCE_PATH="$(readlink "$SOURCE_PATH")"
  case "$SOURCE_PATH" in
    /*) ;;
    *) SOURCE_PATH="$SOURCE_DIR/$SOURCE_PATH" ;;
  esac
done
SELF_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
. "$SELF_DIR/../lib/process-watchdog.sh"
. "$SELF_DIR/../lib/opencode-cli.sh"
. "$SELF_DIR/../lib/model-endpoint.sh"
. "$SELF_DIR/../lib/direct-call.sh"
# Shared by ds-worker, ds-serve and ds-doctor: what the file says must be what
# runs, and what `ds-doctor --config` prints must be what the file says.
# Handles `key = value`, quoted values, a trailing ` # comment`, and a leading ~.
ds_norm_value() {
  local val="$1" key="${2:-}"
  val="${val%%$'\t'#*}"; case "$val" in *" #"*) val="${val%% #*}" ;; esac
  val="${val#"${val%%[![:space:]]*}"}"
  val="${val%"${val##*[![:space:]]}"}"
  case "$val" in
    \"*\") val="${val#\"}"; val="${val%\"}" ;;
    \'*\') val="${val#\'}"; val="${val%\'}" ;;
  esac
  case "$key" in *DIR) val="${val/#\~/$HOME}" ;; esac
  printf '%s' "$val"
}

# ---------------------------------------------------------------------------
# Config file. Precedence: environment > config file > built-in defaults below.
# The file is PARSED, not sourced: a settings file has no business running
# commands, and these scripts drive an agent that can edit code.
DS_CONFIG="${DS_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/ds-worker/config}"
ds_load_config() {
  [ -f "$DS_CONFIG" ] || return 0
  local line key val n=0 locked=" "
  # Snapshot what the environment already set, so a later line in the file can
  # override an earlier one (last wins, as `ds-doctor --config` reports) without
  # any file line ever overriding the environment.
  for key in DS_MODEL_EXPLORER DS_MODEL_REVIEWER DS_MODEL_WORKER \
             DS_MODEL_EXPLORER_FALLBACK DS_MODEL_REVIEWER_FALLBACK DS_MODEL_WORKER_FALLBACK DS_MODEL_RETRIES \
             DS_MODEL_CRITIC \
             DS_MODEL_AUTODETECT DS_MODEL_ENDPOINT \
             DS_TIMEOUT DS_IDLE_TIMEOUT DS_MAX_RUNTIME DS_SERVE DS_AUTO DS_STATE_DIR DS_OPENCODE_HOST DS_OPENCODE_PORT DS_PORT_SCAN DS_PROGRESS_INTERVAL DS_AUTO_RECOVER_READONLY DS_RECOVERY_IDLE_TIMEOUT DS_RECOVERY_MAX_RUNTIME; do
    [ -n "${!key:-}" ] && locked="$locked$key "
  done
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    line="${line#"${line%%[![:space:]]*}"}"          # ltrim
    case "$line" in ''|'#'*) continue ;; esac
    case "$line" in *=*) ;; *) continue ;; esac
    key="${line%%=*}"; val="${line#*=}"
    key="${key//[[:space:]]/}"
    case "$key" in
      DS_MODEL_EXPLORER|DS_MODEL_REVIEWER|DS_MODEL_WORKER|\
      DS_MODEL_EXPLORER_FALLBACK|DS_MODEL_REVIEWER_FALLBACK|DS_MODEL_WORKER_FALLBACK|DS_MODEL_RETRIES|\
      DS_MODEL_CRITIC|\
      DS_MODEL_AUTODETECT|DS_MODEL_ENDPOINT|\
      DS_TIMEOUT|DS_IDLE_TIMEOUT|DS_MAX_RUNTIME|DS_SERVE|\
      DS_AUTO|DS_STATE_DIR|DS_OPENCODE_HOST|DS_OPENCODE_PORT|DS_PORT_SCAN|DS_PROGRESS_INTERVAL|DS_AUTO_RECOVER_READONLY|DS_RECOVERY_IDLE_TIMEOUT|DS_RECOVERY_MAX_RUNTIME) ;;
      *) printf '%s: %s:%s: unknown key %s (ignored)\n' "${0##*/}" "$DS_CONFIG" "$n" "$key" >&2
         continue ;;
    esac
    case "$locked" in *" $key "*) continue ;; esac
    printf -v "$key" '%s' "$(ds_norm_value "$val" "$key")"
  done < "$DS_CONFIG"
}
ds_load_config


DS_STATE_DIR="${DS_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/ds-worker}"
DS_TIMEOUT="${DS_TIMEOUT:-3600}"          # legacy alias for max runtime
DS_IDLE_TIMEOUT="${DS_IDLE_TIMEOUT:-1200}" # 0 disables the outer idle watchdog
DS_MAX_RUNTIME="${DS_MAX_RUNTIME:-$DS_TIMEOUT}"
DS_SERVE="${DS_SERVE:-off}"           # off by default; auto is opt-in
DS_AUTO="${DS_AUTO:-1}"               # 1 = pass --auto (required for headless)
DS_PROGRESS_INTERVAL="${DS_PROGRESS_INTERVAL:-15}"
DS_AUTO_RECOVER_READONLY="${DS_AUTO_RECOVER_READONLY:-1}"
DS_RECOVERY_IDLE_TIMEOUT="${DS_RECOVERY_IDLE_TIMEOUT:-60}"
DS_RECOVERY_MAX_RUNTIME="${DS_RECOVERY_MAX_RUNTIME:-180}"

# Primary model per role: local GX10 box (vLLM, :8000), the only endpoint served.
# There is no second endpoint to fall back to, so the fallback defaults are empty
# and the chain is primary-only; set DS_MODEL_*_FALLBACK to re-arm a second model.
DS_MODEL_EXPLORER="${DS_MODEL_EXPLORER:-gx10/qwen3.8-flash-next}"
DS_MODEL_REVIEWER="${DS_MODEL_REVIEWER:-gx10/qwen3.8-flash-next}"
DS_MODEL_WORKER="${DS_MODEL_WORKER:-gx10/qwen3.8-flash-next}"
DS_MODEL_EXPLORER_FALLBACK="${DS_MODEL_EXPLORER_FALLBACK:-}"
DS_MODEL_REVIEWER_FALLBACK="${DS_MODEL_REVIEWER_FALLBACK:-}"
DS_MODEL_WORKER_FALLBACK="${DS_MODEL_WORKER_FALLBACK:-}"
# The critic role runs the doc-critic agent, whose own config binds a cross-model
# (openai/gpt-6.1-sol): no local pin, no autodetect, no fallback chain. Setting
# DS_MODEL_CRITIC pins a different model for the critic role, exactly once per
# attempt — same semantics as --model.
DS_MODEL_CRITIC="${DS_MODEL_CRITIC:-}"
DS_MODEL_RETRIES="${DS_MODEL_RETRIES:-2}"    # attempts per model before moving on

# The GX10 box serves exactly one model at a time, so the configured primary
# goes stale the moment a different model is loaded. With autodetect on (the
# default), ds-worker asks the endpoint which model is actually loaded and uses
# that instead. DS_MODEL_ENDPOINT is derived from the provider's baseURL in
# opencode.jsonc when left empty, so the URL has exactly one home.
DS_MODEL_AUTODETECT="${DS_MODEL_AUTODETECT:-1}"
DS_MODEL_ENDPOINT="${DS_MODEL_ENDPOINT:-}"
DS_MODEL_DETECT_TIMEOUT="${DS_MODEL_DETECT_TIMEOUT:-5}"

die() { printf 'ds-worker: %s\n' "$1" >&2; exit 2; }
note() { printf 'ds-worker: %s\n' "$1" >&2; }

usage() {
  sed -n '2,28p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
  cat >&2 <<'USAGE'

Examples:
  ds-worker omo oracle "Review this design for failure modes."
  ds-worker omo council "Debate whether to split the auth service."
  ds-worker omo ds-explorer "Find every call site of checkToken in src/."
  ds-worker omo ds-reviewer --file test.log "Rank the root-cause candidates."
  ds-worker critic --file docs/plan/foo.md "Audit this document for factual drift before delivery."
  ds-worker direct --file test.log "Rank the root-cause candidates for this failure."

Each role's model defaults to a primary/fallback chain: the primary model up to
DS_MODEL_RETRIES times, then the fallback model up to DS_MODEL_RETRIES times,
stopping at the first success (default: local DeepSeek on :8000, 2 attempts; no
fallback is configured, so the run fails outright once those are spent — set
DS_MODEL_<ROLE>_FALLBACK to add a second model). --model bypasses the chain and
runs exactly that model once.
For the writing 'worker' role, the chain only continues while --dir is a git
working tree confirmed unchanged since the chain started.
The 'critic' role runs the doc-critic agent on the model bound in the agent's
own config (cross-model by design, not the local engine): no autodetect, no
fallback chain; DS_MODEL_CRITIC or --model pin a model deliberately.

options:
  --dir <path>        working directory for the agent (default: $PWD); the
                      OpenCode child is started there (v2 has no run --dir)
  --model <prov/mdl>  override the model for this call (disables the fallback chain)
  --variant <name>    provider reasoning effort (e.g. high, max, minimal); sent
                      as --model provider/model#variant
  --session <id>      continue an existing OpenCode session
  --continue          continue the last session
  --file <path>       attach a file (repeatable)
  --idle-timeout <s>  no OpenCode NDJSON output for this long (default: $DS_IDLE_TIMEOUT; 0 disables)
  --max-runtime <s>   absolute wall clock limit (default: $DS_MAX_RUNTIME)
  --progress-interval <s>  numeric NDJSON progress heartbeat interval (0 disables)
  --recover-readonly  enable one read-only session recovery (default)
  --no-recover-readonly  disable read-only session recovery
  --timeout <sec>     legacy alias for --max-runtime
  --no-serve          private one-shot server (run --standalone), not ds-serve
  --json              emit a JSON envelope instead of prose
  --raw               emit the raw NDJSON event stream
  --quiet             suppress the trailer on stderr

omo gateway:
  ds-worker omo <agent> [options] "<prompt>"
  agents: oracle | council | librarian | designer | fixer | ds-explorer | ds-reviewer
  For oracle, council, librarian, designer and fixer the model is left to the
  active OMO Slim preset (which may select external models), so no --model is
  passed and no local model autodetect or fallback chain runs — one attempt per
  call; OMO Slim owns its configured seat/model fallback. --model still pins one
  model exactly once. Those five built-ins are OpenCode subagents: each dispatches
  the primary agent 'orchestrator' with a task(subagent_type='<agent>')
  instruction (council asks for every configured seat and a synthesis; the others
  ask for the named subagent once). ds-explorer and ds-reviewer keep
  the configured local model, the fallback chain and the final-report contract.
  On a host without the OMO Slim preset: if 'orchestrator' is absent but the
  named agent is installed, the same envelope dispatches through the first
  visible primary agent in `opencode debug agents` and the result records
  dispatch="omo-fallback-primary"; if the named agent itself is absent, the
  call is refused (exit 2, naming it) before any run is spawned.
  fixer is a potentially WRITING OMO agent: it does not carry the writing
  'worker' role's git-safety contract.
USAGE
  exit 2
}

[ $# -ge 1 ] || usage
ROLE="$1"; shift

# Internal requested-agent / dispatch-agent mapping. ROLE stays the public
# result field; OMO_* drive the final-artifact check, the model choice and the
# recovery decision.
OMO_REQUESTED=""    # gateway agent the caller named (empty for legacy roles)
OMO_CONFIGURED=0    # 1 = the active OMO Slim preset picks the model: no --model
DS_ROLE=""          # for an omo call: which existing DS contract applies
CONTRACT_ROLE=""    # role whose final-report contract applies ("" = none)
DISPATCH="legacy"   # result metadata: legacy ds role or OMO gateway dispatch
ROLE_HAS_LOCAL_MODEL=1  # 0 = the model is not a local-engine pin: no autodetect

case "$ROLE" in
  explorer) AGENT="ds-explorer"; MODEL="$DS_MODEL_EXPLORER"; MODEL_FALLBACK="$DS_MODEL_EXPLORER_FALLBACK"; CONTRACT_ROLE="explorer" ;;
  reviewer) AGENT="ds-reviewer"; MODEL="$DS_MODEL_REVIEWER"; MODEL_FALLBACK="$DS_MODEL_REVIEWER_FALLBACK"; CONTRACT_ROLE="reviewer" ;;
  worker)   AGENT="ds-worker";   MODEL="$DS_MODEL_WORKER";   MODEL_FALLBACK="$DS_MODEL_WORKER_FALLBACK"; CONTRACT_ROLE="worker" ;;
  critic)   AGENT="doc-critic";  MODEL="$DS_MODEL_CRITIC";   MODEL_FALLBACK="";                          CONTRACT_ROLE="critic"; ROLE_HAS_LOCAL_MODEL=0 ;;
  omo)
    DISPATCH="omo-configured"
    # Strict allowlist: an internal mapping, never an arbitrary --agent value.
    OMO_REQUESTED="${1:-}"
    case "$OMO_REQUESTED" in
      # The OMO built-ins are OpenCode subagents: `opencode run --agent <them>`
      # is rejected, so dispatch the primary 'orchestrator' and ask it for the
      # named subagent via task(subagent_type=...).
      oracle|council|librarian|designer|fixer)
        AGENT="orchestrator"; OMO_CONFIGURED=1 ;;
      ds-explorer) AGENT="ds-explorer"; DS_ROLE="explorer"; CONTRACT_ROLE="explorer" ;;
      ds-reviewer) AGENT="ds-reviewer"; DS_ROLE="reviewer"; CONTRACT_ROLE="reviewer" ;;
      *) die "omo: unsupported agent '${OMO_REQUESTED:-<missing>}' (expected: oracle | council | librarian | designer | fixer | ds-explorer | ds-reviewer)" ;;
    esac
    shift
    if [ "$OMO_CONFIGURED" -eq 1 ]; then
      # No model to resolve: the OMO Slim preset owns model arrays, variants and
      # external seats. An empty --model must never reach opencode.
      MODEL=""; MODEL_FALLBACK=""
    elif [ "$DS_ROLE" = "explorer" ]; then
      MODEL="$DS_MODEL_EXPLORER"; MODEL_FALLBACK="$DS_MODEL_EXPLORER_FALLBACK"
    else
      MODEL="$DS_MODEL_REVIEWER"; MODEL_FALLBACK="$DS_MODEL_REVIEWER_FALLBACK"
    fi
    ;;
  # No OpenCode at all: handled before any opencode check below can refuse it.
  direct) ds_direct_main "$@" ;;
  -h|--help) usage ;;
  *) die "unknown role '$ROLE' (expected: explorer | reviewer | worker | critic | omo | direct)" ;;
esac

DIR="$PWD"; VARIANT=""; SESSION=""; CONTINUE=0
OUT_MODE="text"; QUIET=0; FILES=()
PROMPT=""
EXPLICIT_MODEL=0    # 1 once --model is given: runs that single model, no fallback chain

while [ $# -gt 0 ]; do
  case "$1" in
    --dir)      DIR="${2:?--dir needs a value}"; shift 2 ;;
    --model)    MODEL="${2:?--model needs a value}"; EXPLICIT_MODEL=1; shift 2 ;;
    --variant)  VARIANT="${2:?--variant needs a value}"; shift 2 ;;
    --session)  SESSION="${2:?--session needs a value}"; shift 2 ;;
    --continue) CONTINUE=1; shift ;;
    --file)     FILES+=("${2:?--file needs a value}"); shift 2 ;;
    --idle-timeout) DS_IDLE_TIMEOUT="${2:?--idle-timeout needs a value}"; shift 2 ;;
    --max-runtime)  DS_MAX_RUNTIME="${2:?--max-runtime needs a value}"; shift 2 ;;
    --progress-interval) DS_PROGRESS_INTERVAL="${2:?--progress-interval needs a value}"; shift 2 ;;
    --recover-readonly) DS_AUTO_RECOVER_READONLY=1; shift ;;
    --no-recover-readonly) DS_AUTO_RECOVER_READONLY=0; shift ;;
    --timeout)      DS_TIMEOUT="${2:?--timeout needs a value}"; DS_MAX_RUNTIME="$DS_TIMEOUT"; shift 2 ;;
    --no-serve) DS_SERVE="off"; shift ;;
    --json)     OUT_MODE="json"; shift ;;
    --raw)      OUT_MODE="raw"; shift ;;
    --quiet)    QUIET=1; shift ;;
    -h|--help)  usage ;;
    --)         shift; PROMPT="$*"; break ;;
    -)          PROMPT="$(cat)"; shift ;;
    -*)         die "unknown option '$1'" ;;
    *)          PROMPT="${PROMPT:+$PROMPT }$1"; shift ;;
  esac
done

[ -n "$PROMPT" ] || die "no prompt given"
command -v opencode >/dev/null || die "opencode not found on PATH"
command -v jq >/dev/null || die "jq not found on PATH"

is_nonnegative_integer() {
  case "$1" in ''|*[!0-9]*) return 1 ;; esac
}

is_nonnegative_integer "$DS_IDLE_TIMEOUT" \
  || die "--idle-timeout must be a non-negative integer (seconds)"
is_nonnegative_integer "$DS_MAX_RUNTIME" \
  || die "--max-runtime must be a non-negative integer (seconds)"
is_nonnegative_integer "$DS_PROGRESS_INTERVAL" \
  || die "--progress-interval must be a non-negative integer (seconds)"
is_nonnegative_integer "$DS_RECOVERY_IDLE_TIMEOUT" \
  || die "DS_RECOVERY_IDLE_TIMEOUT must be a non-negative integer (seconds)"
is_nonnegative_integer "$DS_RECOVERY_MAX_RUNTIME" \
  || die "DS_RECOVERY_MAX_RUNTIME must be a non-negative integer (seconds)"
is_nonnegative_integer "$DS_MODEL_RETRIES" \
  || die "DS_MODEL_RETRIES must be a non-negative integer"
[ "$DS_MAX_RUNTIME" -gt 0 ] \
  || die "--max-runtime must be greater than zero"
[ "$DS_RECOVERY_MAX_RUNTIME" -gt 0 ] \
  || die "DS_RECOVERY_MAX_RUNTIME must be greater than zero"
[ "$DS_MODEL_RETRIES" -gt 0 ] \
  || die "DS_MODEL_RETRIES must be greater than zero"
case "$DS_AUTO_RECOVER_READONLY" in
  0|1) ;;
  *) die "DS_AUTO_RECOVER_READONLY must be 0 or 1" ;;
esac

DIR="$(cd "$DIR" 2>/dev/null && pwd)" || die "--dir does not exist"
# The child runs inside --dir, so a relative --file must be pinned to the
# caller's cwd before that move.
for _i in "${!FILES[@]}"; do
  case "${FILES[$_i]}" in /*) ;; *) FILES[$_i]="$PWD/${FILES[$_i]}" ;; esac
done
case "$DIR" in
  "$HOME"|/)
    # The legacy writing worker, plus omo fixer: an OMO subagent that may write.
    # fixer gets this refusal only — never the worker's git-status retry guard.
    if [ "$ROLE" = "worker" ] \
       || { [ "$ROLE" = "omo" ] && [ "$OMO_REQUESTED" = "fixer" ]; }; then
      die "refusing to run a writing worker with --dir $DIR"
    fi
    ;;
esac

# OMO gateway honesty on hosts without the OMO Slim preset, before anything is
# spawned. The allowlist routes the five built-ins through the primary agent
# 'orchestrator'; check the agent list for what the preset names imply:
#  - the named agent itself absent (council/designer/fixer where the preset was
#    never installed) -> refuse with exit 2 naming it, no run, no session;
#  - only 'orchestrator' absent while the named subagent IS installed -> dispatch
#    the same task(subagent_type=...) envelope through the first visible primary
#    from the agent list (list order, as every other role in this script takes
#    it; the (primary)-only match skips subagent/hidden rows by construction)
#    and record
#    dispatch="omo-fallback-primary" so the result is honest about which agent's
#    model answered. With the preset installed both checks pass and the behavior
#    is exactly the orchestrator dispatch described above.
if [ "$ROLE" = omo ] && [ "$OMO_CONFIGURED" -eq 1 ]; then
  OMO_AGENT_LIST="$(oc_agent_list)" \
    || die "could not read the agent list ('opencode debug agents' returned no JSON array)"
  if ! printf '%s\n' "$OMO_AGENT_LIST" | grep -qE "^${OMO_REQUESTED} \((primary|subagent|all)\)$"; then
    die "agent '${OMO_REQUESTED}' not installed — OMO Slim preset not installed on this host; see references/portability.md"
  fi
  if ! printf '%s\n' "$OMO_AGENT_LIST" | grep -qE '^orchestrator \((primary|subagent|all)\)$'; then
    # First visible primary in list order, name = the line minus its mode
    # suffix (primary names may contain spaces). List order is the established
    # "first primary" pick: the legacy roles below already rely on unsorted
    # agent-list order. Do NOT sort: an alphabetical sort can pick
    # a preset agent bound to an external seat, which would silently spend
    # tokens this wrapper has no authority over.
    OMO_FALLBACK_PRIMARY="$(printf '%s\n' "$OMO_AGENT_LIST" \
      | awk '/[^[:space:]].* \(primary\)$/ { sub(/ \(primary\)$/, ""); print; exit }')"
    [ -n "$OMO_FALLBACK_PRIMARY" ] \
      || die "OMO Slim 'orchestrator' is not installed and 'opencode debug agents' shows no visible primary agent — cannot dispatch '${OMO_REQUESTED}'"
    note "OMO Slim 'orchestrator' absent — ran via fallback primary ${OMO_FALLBACK_PRIMARY}; results reflect that agent's model, not OMO's"
    AGENT="$OMO_FALLBACK_PRIMARY"
    DISPATCH="omo-fallback-primary"
  fi
fi

# OpenCode v1 `run --agent <unknown>` did NOT fail — it warned on stderr and ran
# the default agent, which has no permission restrictions; same for a
# `mode: subagent` agent. v2 rejects an unknown agent with an error event, but
# the sandbox is too important to rest on one version's behavior, so check up
# front and again after the run. An OMO built-in is expected to be mode=subagent and is never
# passed to `opencode run --agent` directly: the check below covers the dispatch
# agent (orchestrator for the OMO built-ins), which must not be a subagent.
AGENT_LIST="$(oc_agent_list)" \
  || die "could not read the agent list ('opencode debug agents' returned no JSON array)"
AGENT_LINE="$(printf '%s\n' "$AGENT_LIST" | grep "^${AGENT} " || true)"
[ -n "$AGENT_LINE" ] || die "agent '$AGENT' is not installed. Run: sync-agents --install (agents only) or install.sh (bootstrap)"
case "$AGENT_LINE" in
  *"(subagent)"*) die "agent '$AGENT' is mode=subagent; 'opencode run --agent' cannot use it. Set mode: all and re-run sync-agents --install (or install.sh)" ;;
esac

# ---- progress and result contract --------------------------------------------
ds_collect_ndjson_metrics() {
  local output_path="$1" metrics
  DS_PROGRESS_EVENTS=0
  DS_PROGRESS_TOOLS=0
  DS_PROGRESS_TEXT_CHARS=0
  DS_PROGRESS_FINISHES=0

  [ -s "$output_path" ] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  metrics="$(
    jq -R 'fromjson? // empty' <"$output_path" 2>/dev/null |
      jq -s -r '
        [
          length,
          (map(select(.type == "tool_use" or .type == "tool")) | length),
          (map(select(.type == "text") | (.part.text // "") | length) | add // 0),
          (map(select(.type == "step_finish")) | length)
        ] | @tsv
      ' 2>/dev/null || true
  )"
  [ -n "$metrics" ] || return 0
  IFS=$'\t' read -r DS_PROGRESS_EVENTS DS_PROGRESS_TOOLS \
    DS_PROGRESS_TEXT_CHARS DS_PROGRESS_FINISHES <<<"$metrics"
}

ds_report_progress() {
  local output_path="$1" elapsed_seconds="$2"
  ds_collect_ndjson_metrics "$output_path"
  printf 'ds-worker: progress elapsed=%ss events=%s tools=%s text_chars=%s step_finishes=%s\n' \
    "$elapsed_seconds" "$DS_PROGRESS_EVENTS" "$DS_PROGRESS_TOOLS" \
    "$DS_PROGRESS_TEXT_CHARS" "$DS_PROGRESS_FINISHES" >&2
}

ds_start_progress_monitor() {
  local output_path="$1" stop_path="$2" interval="$3"
  [ "$interval" -gt 0 ] || return 0
  (
    local started_at now
    started_at="$(date +%s)"
    while [ ! -e "$stop_path" ]; do
      sleep "$interval" || break
      [ -e "$stop_path" ] && break
      now="$(date +%s)"
      ds_report_progress "$output_path" "$((now - started_at))"
    done
  ) &
  DS_PROGRESS_PID=$!
}

ds_stop_progress_monitor() {
  local stop_path="$1"
  [ -n "${DS_PROGRESS_PID:-}" ] || return 0
  : >"$stop_path"
  kill "$DS_PROGRESS_PID" 2>/dev/null || true
  wait "$DS_PROGRESS_PID" 2>/dev/null || true
  rm -f "$stop_path"
  DS_PROGRESS_PID=""
}

ds_is_read_only_role() {
  # Only roles whose report contract AND safety are known: explorer, reviewer,
  # and the DS roles reached through the omo gateway. Never an OMO-configured
  # agent (a full Council dispatch must not be recovered automatically).
  case "$CONTRACT_ROLE" in
    explorer|reviewer|critic) [ "$OMO_CONFIGURED" -eq 0 ] ;;
    *) return 1 ;;
  esac
}

# Safety guard for the writing `worker` role's fallback chain: a timeout or
# failure can happen after a partial edit, so the chain may only continue to
# the next model/attempt when --dir is provably unchanged since the chain
# started. Not a git working tree = provably nothing, so treat it as unsafe.
ds_git_status_snapshot() {
  local dir="$1"
  git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || { printf '%s' "__not_a_git_repo__"; return 0; }
  git -C "$dir" status --porcelain 2>/dev/null
}

ds_has_required_final_artifact() {
  local text="$1" marker
  case "$CONTRACT_ROLE" in
    explorer)
      for marker in '### SUMMARY' '### FINDINGS' '### SEARCH COVERAGE' '### GAPS'; do
        case "$text" in *"$marker"*) ;; *) return 1 ;; esac
      done
      ;;
    reviewer)
      for marker in '### VERDICT' '### LITERAL EVIDENCE' '### ROOT CAUSE CANDIDATES' '### INSUFFICIENT'; do
        case "$text" in *"$marker"*) ;; *) return 1 ;; esac
      done
      ;;
    worker)
      for marker in '### STATUS' '### CHANGES' '### VERIFICATION' '### NOT DONE' '### RISKS'; do
        case "$text" in *"$marker"*) ;; *) return 1 ;; esac
      done
      ;;
    critic)
      # The doc-critic contract is a one-word gate; sections are conditional by
      # design (a clean document yields no BLOCKERS list), so only the verdict
      # line is required.
      printf '%s\n' "$text" | grep -Eq '^VERDICT:[[:space:]]*(PASS|FIX_NEEDED)[[:space:]]*$' || return 1
      ;;
    *)
      # No ds-worker contract for this agent (the OMO-configured OMO agents):
      # any text the run produced counts as its result.
      [ -n "$text" ] || return 1
      ;;
  esac
  return 0
}

ds_build_result() {
  local raw_path="$1" child_rc="$2" timeout_reason="$3" phase="$4" stderr_path="$5"
  local idle_timeout="$6" max_runtime="$7"
  local base text tool_count has_final=0 outcome status model_json
  # An OMO-configured call has no model of ours to report: null, not "".
  if [ -n "$MODEL" ]; then
    model_json="$(jq -n --arg model "$MODEL" '$model')"
  else
    model_json='null'
  fi

  base="$(jq -R 'fromjson? // empty' <"$raw_path" | jq -s \
    --arg role "$ROLE" --arg agent "$AGENT" --arg dispatch "$DISPATCH" --arg dir "$DIR" --arg raw "$raw_path" \
    --arg stderr "$stderr_path" --arg timeout_reason "$timeout_reason" --arg phase "$phase" \
    --argjson model "$model_json" \
    --argjson rc "$child_rc" --arg idle_timeout "$idle_timeout" --arg max_runtime "$max_runtime" '
    {
      role: $role,
      agent: $agent,
      dispatch: $dispatch,
      model: $model,
      dir: $dir,
      exit: $rc,
      status: (if $rc == 0 then "completed" elif $rc == 124 then "timed_out_unknown" else "failed" end),
      session: (map(.sessionID // empty) | last // null),
      text: (map(select(.type == "text") | .part.text // "") | join("")),
      tools: (map(select(.type == "tool_use" or .type == "tool") | (.part.tool // ""))),
      errors: (map(select(.type == "error") | (.error.message // .error // "error" | tostring))),
      tokens: (map(select(.type == "step_finish") | .part.tokens // empty) | last),
      cost: ((map(select(.type == "step_finish") | .part.cost // 0) | add) // 0),
      events: length,
      step_finish_count: (map(select(.type == "step_finish")) | length),
      idle_timeout: ($idle_timeout | tonumber),
      max_runtime: ($max_runtime | tonumber),
      timeout_reason: (if $rc == 124 then $timeout_reason else null end),
      raw_log: $raw,
      stderr_log: $stderr,
      phase: $phase
    }')"
  text="$(printf '%s' "$base" | jq -r '.text')"
  tool_count="$(printf '%s' "$base" | jq -r '.tools | length')"
  ds_has_required_final_artifact "$text" && has_final=1

  if [ "$child_rc" -eq 0 ] && [ "$has_final" -eq 1 ]; then
    outcome=CLEAN_RESULT
    status=completed
  elif [ "$child_rc" -eq 0 ]; then
    outcome=FINAL_ARTIFACT_MISSING
    status=completed_missing_final_artifact
  elif [ "$child_rc" -eq 124 ] && [ "$tool_count" -gt 0 ] && [ "$has_final" -eq 0 ]; then
    outcome=TOOL_ONLY_NO_FINAL_ARTIFACT
    status=timed_out_unknown
  elif [ "$child_rc" -eq 124 ] && [ "$timeout_reason" = idle ]; then
    outcome=IDLE_TIMEOUT
    status=timed_out_unknown
  elif [ "$child_rc" -eq 124 ] && [ "$timeout_reason" = max-runtime ]; then
    outcome=MAX_RUNTIME
    status=timed_out_unknown
  elif [ "$child_rc" -eq 124 ]; then
    outcome=TIMEOUT
    status=timed_out_unknown
  elif [ "$tool_count" -gt 0 ] && [ "$has_final" -eq 0 ]; then
    outcome=AMBIGUOUS_PARTIAL
    status=failed
  else
    outcome=FAILED
    status=failed
  fi

  printf '%s' "$base" | jq --arg outcome "$outcome" --arg status "$status" \
    --argjson has_final "$has_final" '
    . + {
      status: $status,
      outcome: $outcome,
      has_required_final_artifact: ($has_final == 1),
      tool_count: (.tools | length),
      text_chars: (.text | length)
    }'
}

# ---- backend -----------------------------------------------------------------
# ds-serve prints the URL of a backend *it* owns. It never hands back a foreign
# server (e.g. an OpenCode TUI squatting on 4096) — attaching to one of those
# fails with "Session not found" and would disturb the user's live session.
# Not yet ported to OpenCode v2: a v2 server requires a password, and its GET
# /config now serves the web UI with 200, so ds-serve's ownership probe cannot
# tell its own server from a foreign one. Until it is, every run gets a private
# --standalone server and DS_SERVE only earns a notice.
ATTACH=""
if [ "$DS_SERVE" != "off" ]; then
  note "DS_SERVE=$DS_SERVE ignored: ds-serve is not ported to the OpenCode v2 server yet; using a private --standalone server"
fi

# ---- serving-model autodetect --------------------------------------------------
# One model is loaded at a time, so /v1/models returns exactly that one.

# ds_provider_baseurl and ds_detect_served_model live in lib/model-endpoint.sh.

ds_resolve_served_model() {
  local provider="${MODEL%%/*}" configured="${MODEL#*/}" endpoint detected candidate
  endpoint="$DS_MODEL_ENDPOINT"
  if [ -z "$endpoint" ]; then
    endpoint="$(ds_provider_baseurl "$provider")" || endpoint=""
  fi
  if [ -z "$endpoint" ]; then
    note "autodetect: no baseURL for provider '$provider' in opencode.jsonc; keeping $MODEL"
    return 0
  fi
  detected="$(ds_detect_served_model "$endpoint")" || {
    note "autodetect: $endpoint unreachable; keeping configured $MODEL"
    return 0
  }
  [ "$detected" = "$configured" ] && return 0
  candidate="$provider/$detected"
  if opencode models 2>/dev/null | grep -qxF "$candidate"; then
    note "autodetect: $MODEL is not loaded; $endpoint serves $detected — using $candidate"
    MODEL="$candidate"
  else
    note "autodetect: $endpoint serves '$detected', absent from the '$provider' catalog in opencode.jsonc; keeping $MODEL (add it there to use it)"
  fi
}

# --model pins one model on purpose, so autodetect must not second-guess it.
# An OMO-configured call has no model of ours at all: the preset chooses.
# The critic role has no local-engine pin either (empty = the doc-critic agent
# config owns the model; a set DS_MODEL_CRITIC is an explicit external pin):
# probing "which local model is loaded" for it would either rewrite the
# cross-model binding to the local engine or die on a provider with no baseURL.
if [ "$EXPLICIT_MODEL" -eq 0 ] && [ "$OMO_CONFIGURED" -eq 0 ] \
   && [ "$ROLE_HAS_LOCAL_MODEL" -eq 1 ] && [ "$DS_MODEL_AUTODETECT" = "1" ]; then
  ds_resolve_served_model
fi

# ---- model chain --------------------------------------------------------------
# --model given explicitly: run exactly that model, once, no fallback chain.
# An OMO-configured call: one attempt with no --model; OMO Slim owns its
# configured seat/model fallback, so never retry a full Council blindly.
# Otherwise: the role's primary model up to DS_MODEL_RETRIES times, then its
# fallback model up to DS_MODEL_RETRIES times if one is configured (by default
# none is, so the chain is primary-only). Stops at the first success.
if [ "$EXPLICIT_MODEL" -eq 1 ] || [ "$ROLE" = critic ]; then
  MODEL_CHAIN=("$MODEL")
elif [ "$OMO_CONFIGURED" -eq 1 ]; then
  MODEL_CHAIN=("")
else
  MODEL_CHAIN=()
  for _i in $(seq 1 "$DS_MODEL_RETRIES"); do MODEL_CHAIN+=("$MODEL"); done
  if [ -n "$MODEL_FALLBACK" ]; then
    for _i in $(seq 1 "$DS_MODEL_RETRIES"); do MODEL_CHAIN+=("$MODEL_FALLBACK"); done
  fi
fi
CHAIN_LEN="${#MODEL_CHAIN[@]}"

ENVELOPE="[supervisor task | role=${ROLE} | cwd=${DIR}]

${PROMPT}

Report using your required output format. If you cannot establish something,
say so explicitly rather than filling the gap with a plausible guess."

# The OMO built-ins are subagents: dispatch the orchestrator and ask it for the
# real OMO Slim task, so the seats and models come from the preset. council
# collects every configured seat and synthesizes; the others run one subagent.
if [ "$ROLE" = omo ] && [ "$OMO_CONFIGURED" -eq 1 ]; then
  if [ "$OMO_REQUESTED" = council ]; then
    ENVELOPE="[supervisor task | role=${ROLE} | agent=council | cwd=${DIR}]

${PROMPT}

Dispatch this through the OMO Slim Council now: task(subagent_type='council'),
so every configured council seat answers, then synthesize their answers into
one result. Do not answer from a single seat.

Report using your required output format. If you cannot establish something,
say so explicitly rather than filling the gap with a plausible guess."
  else
    ENVELOPE="[supervisor task | role=${ROLE} | agent=${OMO_REQUESTED} | cwd=${DIR}]

${PROMPT}

Dispatch this through OMO Slim now: task(subagent_type='${OMO_REQUESTED}'),
requesting that one subagent, and return its result. Do not answer yourself and
do not gather multiple seats.

Report using your required output format. If you cannot establish something,
say so explicitly rather than filling the gap with a plausible guess."
  fi
fi

# Advisory only: a read-only run should spend its agentic-step ceiling on the
# highest-value evidence and still emit a report. Nothing here parses or enforces
# a step count, and the notice must never reach a writing role, an OMO-configured
# built-in, or the recovery prompt.
if ds_is_read_only_role; then
  ENVELOPE="$ENVELOPE

Read-only budget notice: Treat any configured agentic-step limit as a safety ceiling, not a target or a tool-call quota. Prioritize the highest-value evidence. Near the ceiling, stop initiating new searches and emit the required report with explicit evidence gaps; never end with tools only."
fi

mkdir -p "$DS_STATE_DIR/runs"

# Safety guard for the writing `worker` role only: a timeout/failure can land
# after a partial edit, so the chain may only continue while --dir is provably
# unchanged since it started. Not a git working tree = provably nothing, so
# that also stops the chain (see ds_git_status_snapshot).
WORKER_SAFETY_BASELINE=""
[ "$ROLE" = worker ] && [ "$EXPLICIT_MODEL" -eq 0 ] \
  && WORKER_SAFETY_BASELINE="$(ds_git_status_snapshot "$DIR")"
CHAIN_STOP_REASON=""
ATTEMPTS_SUMMARY=()
ATTEMPT_INDEX=0

for MODEL in "${MODEL_CHAIN[@]}"; do
  ATTEMPT_INDEX=$((ATTEMPT_INDEX + 1))

  # ---- command -----------------------------------------------------------------
  STAMP="$(date +%Y%m%d-%H%M%S)-$$-a${ATTEMPT_INDEX}"
  RAW="$DS_STATE_DIR/runs/${STAMP}-${ROLE}.ndjson"
  ERR="$DS_STATE_DIR/runs/${STAMP}-${ROLE}.stderr"

  # Never pass an empty --model: an OMO-configured call lets the preset choose.
  # No --server means a private --standalone server: v2's default is a shared
  # background service, which is not the one-shot process DS_SERVE=off promises
  # and has been seen unable to reach the GX10 box (EHOSTUNREACH).
  ARGS=(run --agent "$AGENT" --format json)
  [ -n "$MODEL" ]   && ARGS+=(--model "$(oc_model_ref "$MODEL" "$VARIANT")")
  if [ -n "$ATTACH" ]; then ARGS+=(--server "$ATTACH"); else ARGS+=(--standalone); fi
  [ -n "$SESSION" ] && ARGS+=(--session "$SESSION")
  [ "$CONTINUE" -eq 1 ] && ARGS+=(--continue)
  [ "$DS_AUTO" = "1" ] && ARGS+=(--auto)
  for f in "${FILES[@]:-}"; do [ -n "$f" ] && ARGS+=(--file "$f"); done
  # `--file` was a yargs *array* option in v1: without a `--` terminator it
  # swallowed the prompt. v2 accepts the terminator too, so keep it.
  ARGS+=(--)

  PROGRESS_INTERVAL_EFFECTIVE="$DS_PROGRESS_INTERVAL"
  [ "$QUIET" -eq 1 ] && PROGRESS_INTERVAL_EFFECTIVE=0
  PROGRESS_STOP="$DS_STATE_DIR/runs/${STAMP}-${ROLE}.progress.stop"
  DS_PROGRESS_PID=""
  [ "$QUIET" -eq 1 ] || note "attempt $ATTEMPT_INDEX/$CHAIN_LEN role=$ROLE model=$MODEL raw_stream=$RAW"
  ds_start_progress_monitor "$RAW" "$PROGRESS_STOP" "$PROGRESS_INTERVAL_EFFECTIVE"
  RC=0
  ds_run_with_watchdog "$DS_IDLE_TIMEOUT" "$DS_MAX_RUNTIME" "$RAW" "$ERR" \
    oc_in_dir "$DIR" opencode "${ARGS[@]}" "$ENVELOPE" || RC=$?
  ds_stop_progress_monitor "$PROGRESS_STOP"

  if [ "$RC" -eq 124 ]; then
    note "attempt $ATTEMPT_INDEX/$CHAIN_LEN timed out (${DS_WATCHDOG_REASON}) after idle=${DS_IDLE_TIMEOUT}s max=${DS_MAX_RUNTIME}s (partial stream: $RAW)"
  fi

  if grep -q "Falling back to default agent" "$ERR" 2>/dev/null; then
    note "opencode ignored --agent $AGENT and ran the UNRESTRICTED default agent."
    note "the sandbox for role '$ROLE' did not apply. stderr: $ERR"
    note "fix: re-run sync-agents --install (or install.sh) (agent files must be real files, not symlinks)"
    exit 3
  fi

  # ---- parse -------------------------------------------------------------------
  INITIAL_TIMEOUT_REASON=none
  [ "$RC" -eq 124 ] && INITIAL_TIMEOUT_REASON="${DS_WATCHDOG_REASON:-unknown}"
  INITIAL_RESULT="$(ds_build_result "$RAW" "$RC" "$INITIAL_TIMEOUT_REASON" initial "$ERR" "$DS_IDLE_TIMEOUT" "$DS_MAX_RUNTIME")"
  INITIAL_TEXT="$(printf '%s' "$INITIAL_RESULT" | jq -r '.text')"
  INITIAL_SESSION="$(printf '%s' "$INITIAL_RESULT" | jq -r '.session // empty')"
  INITIAL_HAS_FINAL="$(printf '%s' "$INITIAL_RESULT" | jq -r 'if .has_required_final_artifact then 1 else 0 end')"
  INITIAL_OUTCOME="$(printf '%s' "$INITIAL_RESULT" | jq -r '.outcome')"
  INITIAL_STATUS="$(printf '%s' "$INITIAL_RESULT" | jq -r '.status')"
  INITIAL_TIMEOUT_REASON="$(printf '%s' "$INITIAL_RESULT" | jq -r '.timeout_reason // empty')"

  FINAL_RESULT="$INITIAL_RESULT"
  FINAL_TEXT="$INITIAL_TEXT"
  FINAL_RC="$RC"
  RECOVERY_ATTEMPTED=0
  RECOVERY_SUCCEEDED=0
  RECOVERY_RAW=""
  RECOVERY_ERR=""
  RECOVERY_RC=0
  RECOVERY_EXIT_JSON=null
  RECOVERY_OUTCOME=""
  RECOVERY_TIMEOUT_REASON=""

  if [ "$DS_AUTO_RECOVER_READONLY" -eq 1 ] && ds_is_read_only_role \
     && [ "$INITIAL_HAS_FINAL" -eq 0 ] && [ -n "$INITIAL_SESSION" ]; then
    RECOVERY_ATTEMPTED=1
    RECOVERY_RAW="$DS_STATE_DIR/runs/${STAMP}-${ROLE}-recovery.ndjson"
    RECOVERY_ERR="$DS_STATE_DIR/runs/${STAMP}-${ROLE}-recovery.stderr"
    RECOVERY_STOP="$DS_STATE_DIR/runs/${STAMP}-${ROLE}-recovery.progress.stop"
    RECOVERY_PROMPT="Your previous read-only ${CONTRACT_ROLE} run ended before emitting the required final report. Do not use tools or perform more searches. Using only the work already completed in this session, emit the required ${CONTRACT_ROLE} report now in the exact required format. If evidence is incomplete, say so explicitly in the required gap section. Do not claim verification without evidence."
    RECOVERY_ARGS=(run --agent "$AGENT" --format json)
    [ -n "$MODEL" ] && RECOVERY_ARGS+=(--model "$(oc_model_ref "$MODEL" "$VARIANT")")
    if [ -n "$ATTACH" ]; then RECOVERY_ARGS+=(--server "$ATTACH"); else RECOVERY_ARGS+=(--standalone); fi
    # Keep the explicit session id while marking this as a continuation. The
    # former selects the exact timed-out session; the latter prevents OpenCode
    # from treating recovery as a fresh run when the watchdog interrupted it.
    RECOVERY_ARGS+=(--session "$INITIAL_SESSION" --continue)
    [ "$DS_AUTO" = "1" ] && RECOVERY_ARGS+=(--auto)
    for f in "${FILES[@]:-}"; do [ -n "$f" ] && RECOVERY_ARGS+=(--file "$f"); done
    RECOVERY_ARGS+=(--)

    # Recovery only reports what the session already produced: no tools, no
    # thinking. Scope the override to this child via `env` so the initial run
    # and the rest of the chain never see it.
    RECOVERY_CONFIG_CONTENT="$(jq -cn --arg agent "$AGENT" \
      '{agent: {($agent): {tools: {"*": false}, options: {chat_template_kwargs: {enable_thinking: false}}}}}')"
    [ "$QUIET" -eq 1 ] || note "read-only recovery attempt session=$INITIAL_SESSION raw_stream=$RECOVERY_RAW"
    DS_PROGRESS_PID=""
    ds_start_progress_monitor "$RECOVERY_RAW" "$RECOVERY_STOP" "$PROGRESS_INTERVAL_EFFECTIVE"
    RECOVERY_RC=0
    ds_run_with_watchdog "$DS_RECOVERY_IDLE_TIMEOUT" "$DS_RECOVERY_MAX_RUNTIME" "$RECOVERY_RAW" "$RECOVERY_ERR" \
      oc_in_dir "$DIR" env OPENCODE_CONFIG_CONTENT="$RECOVERY_CONFIG_CONTENT" \
      opencode "${RECOVERY_ARGS[@]}" "$RECOVERY_PROMPT" || RECOVERY_RC=$?
    ds_stop_progress_monitor "$RECOVERY_STOP"
    if grep -q "Falling back to default agent" "$RECOVERY_ERR" 2>/dev/null; then
      note "opencode ignored --agent $AGENT during read-only recovery and ran the UNRESTRICTED default agent."
      note "the recovery sandbox did not apply. stderr: $RECOVERY_ERR"
      exit 3
    fi
    RECOVERY_TIMEOUT_REASON=none
    [ "$RECOVERY_RC" -eq 124 ] && RECOVERY_TIMEOUT_REASON="${DS_WATCHDOG_REASON:-unknown}"
    RECOVERY_RESULT="$(ds_build_result "$RECOVERY_RAW" "$RECOVERY_RC" "$RECOVERY_TIMEOUT_REASON" recovery "$RECOVERY_ERR" "$DS_RECOVERY_IDLE_TIMEOUT" "$DS_RECOVERY_MAX_RUNTIME")"
    RECOVERY_OUTCOME="$(printf '%s' "$RECOVERY_RESULT" | jq -r '.outcome')"
    RECOVERY_HAS_FINAL="$(printf '%s' "$RECOVERY_RESULT" | jq -r 'if .has_required_final_artifact then 1 else 0 end')"
    RECOVERY_EXIT_JSON="$RECOVERY_RC"

    if [ "$RECOVERY_RC" -eq 0 ] && [ "$RECOVERY_HAS_FINAL" -eq 1 ]; then
      RECOVERY_SUCCEEDED=1
      FINAL_RESULT="$RECOVERY_RESULT"
      FINAL_TEXT="$(printf '%s' "$RECOVERY_RESULT" | jq -r '.text')"
      FINAL_RC=0
    else
      FINAL_TEXT="$INITIAL_TEXT"
      [ "$RC" -eq 0 ] && FINAL_RC=4
    fi
  elif [ "$RC" -eq 0 ] && [ "$INITIAL_HAS_FINAL" -eq 0 ]; then
    FINAL_RC=4
  fi

  ATTEMPTS_SUMMARY+=("$(jq -nc --argjson n "$ATTEMPT_INDEX" --arg model "$MODEL" \
    --argjson exit "$RC" --arg outcome "$INITIAL_OUTCOME" \
    --argjson recovered "$RECOVERY_SUCCEEDED" --argjson wrapper_exit "$FINAL_RC" '
    {attempt: $n, model: $model, exit: $exit, outcome: $outcome,
     recovered: ($recovered == 1), wrapper_exit: $wrapper_exit}')")

  [ "$FINAL_RC" -eq 0 ] && break

  if [ "$ROLE" = worker ] && [ "$EXPLICIT_MODEL" -eq 0 ] && [ "$ATTEMPT_INDEX" -lt "$CHAIN_LEN" ]; then
    if [ "$WORKER_SAFETY_BASELINE" = "__not_a_git_repo__" ]; then
      CHAIN_STOP_REASON="--dir is not a git working tree; cannot confirm attempt $ATTEMPT_INDEX made no partial edits, so the fallback chain stops here rather than risk a duplicate edit."
      note "$CHAIN_STOP_REASON"
      break
    fi
    CURRENT_SNAPSHOT="$(ds_git_status_snapshot "$DIR")"
    if [ "$CURRENT_SNAPSHOT" != "$WORKER_SAFETY_BASELINE" ]; then
      CHAIN_STOP_REASON="attempt $ATTEMPT_INDEX (model=$MODEL) left uncommitted changes in $DIR; stopping the fallback chain instead of risking a conflicting edit. Inspect with: git -C \"$DIR\" status"
      note "$CHAIN_STOP_REASON"
      break
    fi
  fi
done

FALLBACK_USED=0
[ "$ATTEMPT_INDEX" -gt "$DS_MODEL_RETRIES" ] && FALLBACK_USED=1
ATTEMPTS_JSON="$(printf '%s\n' "${ATTEMPTS_SUMMARY[@]}" | jq -s '.')"

FINAL_RESULT="$(printf '%s' "$FINAL_RESULT" | jq \
  --argjson wrapper_exit "$FINAL_RC" \
  --argjson recovery_attempted "$RECOVERY_ATTEMPTED" \
  --argjson recovery_succeeded "$RECOVERY_SUCCEEDED" \
  --argjson initial_exit "$RC" \
  --arg initial_outcome "$INITIAL_OUTCOME" \
  --arg initial_status "$INITIAL_STATUS" \
  --arg initial_timeout_reason "$INITIAL_TIMEOUT_REASON" \
  --arg initial_raw_log "$RAW" \
  --arg initial_stderr_log "$ERR" \
  --arg recovery_raw_log "$RECOVERY_RAW" \
  --arg recovery_stderr_log "$RECOVERY_ERR" \
  --arg recovery_outcome "$RECOVERY_OUTCOME" \
  --arg recovery_timeout_reason "$RECOVERY_TIMEOUT_REASON" \
  --argjson recovery_exit "$RECOVERY_EXIT_JSON" \
  --argjson attempts "$ATTEMPTS_JSON" \
  --argjson attempt_count "$ATTEMPT_INDEX" \
  --argjson chain_length "$CHAIN_LEN" \
  --argjson fallback_used "$FALLBACK_USED" \
  --arg chain_stop_reason "$CHAIN_STOP_REASON" '
  . + {
    wrapper_exit: $wrapper_exit,
    recovered: ($recovery_succeeded == 1),
    recovery_attempted: ($recovery_attempted == 1),
    recovery_succeeded: ($recovery_succeeded == 1),
    initial_exit: $initial_exit,
    initial_outcome: $initial_outcome,
    initial_status: $initial_status,
    initial_timeout_reason: (if $initial_timeout_reason == "" then null else $initial_timeout_reason end),
    initial_raw_log: $initial_raw_log,
    initial_stderr_log: $initial_stderr_log,
    recovery_raw_log: (if $recovery_raw_log == "" then null else $recovery_raw_log end),
    recovery_stderr_log: (if $recovery_stderr_log == "" then null else $recovery_stderr_log end),
    recovery_outcome: (if $recovery_outcome == "" then null else $recovery_outcome end),
    recovery_timeout_reason: (if $recovery_timeout_reason == "" then null else $recovery_timeout_reason end),
    recovery_exit: (if $recovery_attempted == 1 then $recovery_exit else null end),
    attempts: $attempts,
    attempt_count: $attempt_count,
    chain_length: $chain_length,
    fallback_used: ($fallback_used == 1),
    chain_stop_reason: (if $chain_stop_reason == "" then null else $chain_stop_reason end)
  }')"

case "$OUT_MODE" in
  raw)
    cat "$RAW"
    if [ "$RECOVERY_ATTEMPTED" -eq 1 ] && [ -f "$RECOVERY_RAW" ]; then cat "$RECOVERY_RAW"; fi
    ;;
  json)
    printf '%s\n' "$FINAL_RESULT"
    ;;
  text)
    if [ -n "$FINAL_TEXT" ]; then
      printf '%s\n' "$FINAL_TEXT"
    else
      note "no text output; stderr follows"
      printf '%s' "$FINAL_RESULT" | jq -r '.errors[]? | "ds-worker: opencode error: \(.)"' >&2
      sed -n '1,40p' "$ERR" >&2
      if [ "$RECOVERY_ATTEMPTED" -eq 1 ] && [ -f "$RECOVERY_ERR" ]; then
        sed -n '1,40p' "$RECOVERY_ERR" >&2
      fi
    fi
    ;;
esac

if [ "$QUIET" -eq 0 ] && [ "$OUT_MODE" != "raw" ]; then
  printf '%s' "$FINAL_RESULT" | jq -r '
    "--\nrole=\(.role) model=\(.model) session=\(.session // "-") " +
    "status=\(.status) outcome=\(.outcome) tools=\(.tool_count) " +
    "recovered=\(.recovered) wrapper_exit=\(.wrapper_exit) " +
    "attempt=\(.attempt_count)/\(.chain_length) fallback_used=\(.fallback_used) raw_log=\(.raw_log)"' >&2
fi

exit "$FINAL_RC"
